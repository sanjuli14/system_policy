# 🔐 PESADILLA PROCEDURAL - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# API Key de OpenRouter (Obligatorio)
# Obtén tu key gratuita en: https://openrouter.ai/keys
NG_APP_OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Opcional: Nombre del streamer por defecto
NG_APP_DEFAULT_PLAYER_NAME=Streamer
